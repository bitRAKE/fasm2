; vnni_ifma.ref -- error checks of tests/iset/vnni_ifma.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: neither VNNI feature
use64
use vexauto, rexauto
use i386, x64, AVX2
vpdpbusd ymm1, ymm2, ymm3		; 'AVX_VNNI or AVX512_VNNI required'

; FAIL 2: AVX_VNNI only: no zmm
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_VNNI
vpdpbusd zmm1, zmm2, zmm3		; 'invalid operand'

; FAIL 3: AVX_VNNI only: no masks
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_VNNI
vpdpbusd ymm1{k1}, ymm2, ymm3		; 'invalid operand'

; FAIL 4: neither IFMA feature
use64
use vexauto, rexauto
use i386, x64, AVX2
vpmadd52luq ymm1, ymm2, ymm3		; 'AVX_IFMA or AVX512_IFMA required'

; FAIL 5: INT8 has its own bit
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_VNNI, AVX_VNNI_INT16
vpdpbssd ymm1, ymm2, ymm3		; 'AVX_VNNI_INT8 or higher required'

; FAIL 6: INT16 has its own bit
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_VNNI, AVX_VNNI_INT8
vpdpwsud ymm1, ymm2, ymm3		; 'AVX_VNNI_INT16 or higher required'

; FAIL 7: INT8 is VEX only, even with AVX-512
use64
use vexauto, rexauto
use everything
vpdpbssd zmm1, zmm2, zmm3		; 'invalid operand'

; FAIL 8: 256-bit VEX integer forms need AVX2
use64
use vexauto, rexauto
use i386, x64, AVX, AVX_VNNI
vpdpbusd ymm1, ymm2, ymm3		; 'AVX2 or higher required'

; FAIL 9: AVX_VNNI only: no xmm16+
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_VNNI
vpdpbusd xmm1, xmm2, xmm19		; 'invalid operand'
