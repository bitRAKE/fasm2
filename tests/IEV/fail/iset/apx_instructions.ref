; FAIL 1: every new instruction needs APX_F
use64
use everything
use vexauto, rexauto
use i386, x64
push2 rax, rbx		; 'APX_F or higher required'

; FAIL 2
use64
use everything
use vexauto, rexauto
use i386, x64
pushp rax		; 'APX_F or higher required'

; FAIL 3
use64
use everything
use vexauto, rexauto
use i386, x64
jmpabs 0		; 'APX_F or higher required'

; FAIL 4: a register list with r16 too
use64
use everything
use vexauto, rexauto
use i386, x64
push rax r16		; 'APX_F or higher required'

; FAIL 5: 64-bit code only
use64
use everything
use vexauto, rexauto
use32
pop2 eax, ebx		; 'bits64 or higher required'

; FAIL 6: #UD: rsp (llvm-mc encodes it)
use64
use everything
use vexauto, rexauto
push2 rsp, rax		; 'rsp not allowed'

; FAIL 7
use64
use everything
use vexauto, rexauto
pop2 rax, rsp		; 'rsp not allowed'

; FAIL 8: #UD: pop2 into one register twice (llvm-mc encodes it)
use64
use everything
use vexauto, rexauto
pop2 rax, rax		; 'pop2 registers must differ'

; FAIL 9: 64-bit registers only
use64
use everything
use vexauto, rexauto
push2 eax, ebx		; 'invalid combination of operands'

; FAIL 10: Mod=3: no memory operand
