; sm.ref -- error checks of tests/iset/sm.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: SM4 does not enable SM3
use64
use vexauto, rexauto
use i386, x64, AVX, SM4
vsm3msg1 xmm1, xmm2, xmm3		; 'SM3 or higher required'

; FAIL 2: SM3 does not enable SM4
use64
use vexauto, rexauto
use i386, x64, AVX, SM3
vsm4key4 xmm1, xmm2, xmm3		; 'SM4 or higher required'

; FAIL 3: SM3 is 128-bit only
use64
use vexauto, rexauto
use everything
vsm3msg2 ymm1, ymm2, ymm3		; 'invalid combination of operands'

; FAIL 4: SM4 has no EVEX form here: no zmm
use64
use vexauto, rexauto
use everything
vsm4rnds4 zmm1, zmm2, zmm3		; 'invalid operand'

; FAIL 5: one-byte immediate
use64
use vexauto, rexauto
use everything
vsm3rnds2 xmm1, xmm2, xmm3, word 5		; 'invalid operand size'

; FAIL 6: XSAVEC, once in the same window, does not enable it
use64
use vexauto, rexauto
use i386, x64, AVX, XSAVE, XSAVEC
vsm3msg1 xmm1, xmm2, xmm3		; 'SM3 or higher required'
