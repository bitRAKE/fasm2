
; RICHEDIT structures and constants (64-bit)
; Covers msftedit.dll (RichEdit 4.1) loaded dynamically
; Constants are identical to richedit.inc; structures differ for pointer-sized fields

; Character formatting structure (no pointer fields — same layout on 32/64)

struct CHARFORMATW
  cbSize		dd ?
  dwMask		dd ?
  dwEffects		dd ?
  yHeight		dd ?
  yOffset		dd ?
  crTextColor		dd ?
  bCharSet		db ?
  bPitchAndFamily	db ?
  szFaceName		du 32 dup (?) ; LF_FACESIZE wide chars (64 bytes)
			dw ?	      ; tail alignment to DWORD
ends

; Stream I/O structure
; Richedit.h uses #pragma pack(4) on x64, so pfnCallback sits at offset 0Ch
; (immediately after dwCookie+dwError with no 8-byte alignment gap)

struct EDITSTREAM, packed
  dwCookie    dq ?      ; offset 0
  dwError     dd ?      ; offset 8
  pfnCallback dq ?      ; offset 0Ch — 8-byte pointer stored at 4-byte boundary
ends

; Text range structures

struct CHARRANGE
  cpMin dd ?
  cpMax dd ?
ends

struct TEXTRANGEW
  chrg      CHARRANGE
  lpstrText dq ?
ends

struct FINDTEXTEXW
  chrg      CHARRANGE
  lpstrText dq ?
  chrgText  CHARRANGE
ends

struct GETTEXTEX
  cb		  dd ?
  flags 	  dd ?
  codepage	  dd ?
		  dd ?
  lpDefaultChar  dq ?
  lpUsedDefChar  dq ?
ends

struct SETTEXTEX
  flags 	  dd ?
  codepage	  dd ?
ends

; Notification filter structure

struct MSGFILTER
  nmhdr  NMHDR     ; 24 bytes on x64
  msg    dd ?
	 dd ?      ; align wParam to 8 bytes
  wParam dq ?
  lParam dq ?
ends

