; fma4.ref -- error checks of tests/iset/fma4.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: FMA (FMA3) does not provide FMA4
use64
use vexauto, rexauto
use i386, x64, AVX, FMA
vfmaddps xmm0, xmm1, xmm2, xmm3		; 'FMA4 or higher required'

; FAIL 2: scalar memory is 32/64-bit
use64
use vexauto, rexauto
use everything
vfmaddss xmm0, xmm1, xmm2, qword [rax]		; 'operand sizes do not match'

; FAIL 3: scalar forms are xmm only
use64
use vexauto, rexauto
use everything
vfmaddsd ymm0, ymm1, ymm2, ymm3		; 'invalid combination of operands'

; FAIL 4: vfmaddsub has no scalar form
use64
use vexauto, rexauto
use everything
vfmaddsubss xmm0, xmm1, xmm2, xmm3		; 'illegal instruction'

; FAIL 5: one memory operand, never in src1
use64
use vexauto, rexauto
use everything
vfmaddps xmm0, [rax], xmm2, xmm3		; 'invalid combination of operands'
