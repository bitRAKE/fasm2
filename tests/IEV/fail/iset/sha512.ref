; sha512.ref -- error checks of tests/iset/sha512.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: SHA (SHA-1/SHA-256) is a different feature
use64
use vexauto, rexauto
use i386, x64, AVX, SHA
vsha512msg1 ymm1, xmm2		; 'SHA512 or higher required'

; FAIL 2: XSAVEOPT, once in the same window, does not enable it
use64
use vexauto, rexauto
use i386, x64, AVX, XSAVE, XSAVEOPT
vsha512msg2 ymm1, ymm2		; 'SHA512 or higher required'

; FAIL 3: register operands only
use64
use vexauto, rexauto
use everything
vsha512msg1 ymm1, [rax]		; 'invalid combination of operands'

; FAIL 4: the third operand is xmm
use64
use vexauto, rexauto
use everything
vsha512rnds2 ymm1, ymm2, ymm3		; 'invalid combination of operands'

; FAIL 5: VEX only: no ymm16+
use64
use vexauto, rexauto
use everything
vsha512msg2 ymm1, ymm17		; 'invalid operand'

; FAIL 6: and SHA512 does not enable XSAVEOPT
use64
use vexauto, rexauto
use i386, x64, AVX, XSAVE, SHA512
xsaveopt [rax]		; 'XSAVEOPT required'
