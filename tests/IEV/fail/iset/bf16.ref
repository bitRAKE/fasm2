; bf16.ref -- error checks of tests/iset/bf16.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: vdpbf16ps is AVX512_BF16 only
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_NE_CONVERT
vdpbf16ps ymm1, ymm2, ymm3		; 'AVX512_BF16 or higher required'

; FAIL 2: neither feature
use64
use vexauto, rexauto
use i386, x64, AVX2
vcvtneps2bf16 xmm1, ymm2		; 'AVX_NE_CONVERT or AVX512_BF16 required'

; FAIL 3: AVX_NE_CONVERT only: no masks
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_NE_CONVERT
vcvtneps2bf16 xmm1{k1}, ymm2		; 'invalid operand'

; FAIL 4: xmm destination: 128- or 256-bit source?
use64
use vexauto, rexauto
use everything
vcvtneps2bf16 xmm1, [rax]		; 'operand size not specified'

; FAIL 5: the destination is half the source
use64
use vexauto, rexauto
use everything
vcvtneps2bf16 ymm1, ymm2		; 'invalid operand size'

; FAIL 6: the loads take memory only
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_NE_CONVERT
vcvtneebf162ps ymm1, ymm2		; 'invalid combination of operands'

; FAIL 7: broadcast loads read one word
use64
use vexauto, rexauto
use i386, x64, AVX2, AVX_NE_CONVERT
vbcstnebf162ps ymm1, dword [rax]		; 'invalid operand size'

; FAIL 8: the loads are AVX_NE_CONVERT only
use64
use vexauto, rexauto
use everything
use i386, x64, AVX512F, AVX512_BF16
vcvtneoph2ps ymm1, [rax]		; 'AVX_NE_CONVERT or higher required'

; FAIL 9: the loads are VEX only: no zmm
use64
use vexauto, rexauto
use everything
vcvtneebf162ps zmm1, [rax]		; 'invalid operand'
