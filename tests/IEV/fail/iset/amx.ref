; amx.ref -- error checks of tests/iset/amx.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: AMX_BF16 does not enable FP16
use64
use vexauto, rexauto
use i386, x64, AMX_TILE, AMX_BF16
tdpfp16ps tmm1, tmm2, tmm3		; 'AMX_FP16 or higher required'

; FAIL 2: the tile feature is required too
use64
use vexauto, rexauto
use i386, x64, AMX_FP16
tdpfp16ps tmm1, tmm2, tmm3		; 'AMX_TILE or higher required'

; FAIL 3: AMX_FP16 does not enable the complex products
use64
use vexauto, rexauto
use i386, x64, AMX_TILE, AMX_FP16
tcmmimfp16ps tmm1, tmm2, tmm3		; 'AMX_COMPLEX or higher required'

; FAIL 4: distinct tiles
use64
use vexauto, rexauto
use everything
tcmmrlfp16ps tmm1, tmm2, tmm1		; 'tile registers must be distinct'

; FAIL 5: 64-bit mode only
use64
use vexauto, rexauto
use32
use everything
tdpfp16ps tmm1, tmm2, tmm3		; 'bits64 or higher required'

; FAIL 6: tile registers only
use64
use vexauto, rexauto
use everything
tdpfp16ps tmm1, tmm2, zmm3		; 'invalid operand'
