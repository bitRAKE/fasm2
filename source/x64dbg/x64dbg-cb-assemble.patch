diff --git a/src/dbg/_plugins.h b/src/dbg/_plugins.h
--- a/src/dbg/_plugins.h
+++ b/src/dbg/_plugins.h
@@ -248,0 +249,13 @@ typedef struct
+typedef struct
+{
+    duint addr;
+    const char* instruction;
+    unsigned char* dest;
+    int destSize;
+    int size;
+    char* error;
+    int errorSize;
+    bool handled;
+    bool success;
+} PLUG_CB_ASSEMBLE;
+
@@ -309,0 +323 @@ typedef enum
+    CB_ASSEMBLE, //PLUG_CB_ASSEMBLE
diff --git a/src/dbg/assemble.h b/src/dbg/assemble.h
--- a/src/dbg/assemble.h
+++ b/src/dbg/assemble.h
@@ -9,0 +10 @@ enum class AssemblerEngine
+    Plugin = 3,
diff --git a/src/dbg/assemble.cpp b/src/dbg/assemble.cpp
--- a/src/dbg/assemble.cpp
+++ b/src/dbg/assemble.cpp
@@ -14,0 +15 @@
+#include "plugin_loader.h"
@@ -46,0 +48,28 @@ bool assemble(duint addr, unsigned char* dest, int destsize, int* size, const ch
+
+    if(assemblerEngine == AssemblerEngine::Plugin)
+    {
+        if(plugincbempty(CB_ASSEMBLE))
+        {
+            if(error)
+                strcpy_s(error, MAX_ERROR_SIZE, "No assembler provider plugin is loaded");
+            return false;
+        }
+        PLUG_CB_ASSEMBLE info = {};
+        info.addr = addr;
+        info.instruction = instruction;
+        info.dest = dest;
+        info.destSize = destsize;
+        info.error = error;
+        info.errorSize = error ? MAX_ERROR_SIZE : 0;
+        plugincbcall(CB_ASSEMBLE, &info);
+        if(info.handled)
+        {
+            if(size)
+                *size = info.size;
+            return info.success;
+        }
+        if(error)
+            strcpy_s(error, MAX_ERROR_SIZE, "No assembler provider plugin handled the instruction");
+        return false;
+    }
+
