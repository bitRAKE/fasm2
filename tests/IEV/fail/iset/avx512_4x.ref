; FAIL 1: 4VNNIW does not provide 4FMAPS
use64
use vexauto, rexauto
use i386, x64, AVX512F, AVX512_4VNNIW
v4fmaddps zmm1, zmm4+3, [rax]		; 'AVX512_4FMAPS or higher required'

; FAIL 2: packed forms are 512-bit only
use64
use vexauto, rexauto
use everything
v4fmaddps ymm1, ymm4+3, [rax]		; 'invalid operand size'

; FAIL 3: the last operand is memory
use64
use vexauto, rexauto
use everything
v4fmaddps zmm1, zmm4+3, zmm8		; 'invalid combination of operands'

; FAIL 4: it is 128 bits
use64
use vexauto, rexauto
use everything
v4fmaddss xmm1, xmm4+3, qword [rax]		; 'invalid operand size'
