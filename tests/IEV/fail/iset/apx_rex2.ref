; FAIL 1: r16-r31 need APX_F
use64
use everything
use vexauto, rexauto
use i386, x64
add rax, r16		; 'APX_F or higher required'

; FAIL 2: also for the opcode-register forms
use64
use everything
use vexauto, rexauto
use i386, x64
push r16		; 'APX_F or higher required'

; FAIL 3: and 64-bit code
use64
use everything
use vexauto, rexauto
use32
mov eax, r16d		; 'bits64 or higher required'

; FAIL 4: like REX, REX2 turns ah-bh into spl-dil
use64
use everything
use vexauto, rexauto
mov ah, r16b		; 'disallowed combination of registers'

; FAIL 5: r16-r31 need the EVEX form; a VEX gather has none
use64
use everything
use vexauto, rexauto
vpgatherdd xmm0, [r16+xmm1], xmm2		; 'extended register not supported by this encoding'

; FAIL 6: a VEX instruction with no EVEX form is not promoted
use64
use everything
use vexauto, rexauto
vaesimc xmm0, [r16]		; 'extended register not supported by this encoding'

; FAIL 7: the EVEX form needs AVX-512
use64
use everything
use vexauto, rexauto
use i386, x64, AVX2, APX_F
vcvtss2si r16d, xmm0		; 'AVX512F or higher required'

