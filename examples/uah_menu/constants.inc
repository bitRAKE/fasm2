MENU_STATE_COMBOBOXEDIT	= ODS_COMBOBOXEDIT
MENU_STATE_RADIO	= 4000h
MENU_STATE_HASSUB	= 8000h

MENU_STATE_UNAVAILABLE	= MENU_STATE_GRAYED or MENU_STATE_DISABLED
MENU_STATE_ODS_MASK	= MENU_STATE_SELECTED or MENU_STATE_GRAYED or\
		MENU_STATE_DISABLED or MENU_STATE_CHECKED or\
		MENU_STATE_FOCUS or MENU_STATE_DEFAULT or MENU_STATE_HOT or\
		MENU_STATE_INACTIVE or MENU_STATE_NOACCEL or\
		MENU_STATE_NOFOCUSRECT or MENU_STATE_COMBOBOXEDIT

assert MENU_STATE_SELECTED = ODS_SELECTED
assert MENU_STATE_GRAYED = ODS_GRAYED
assert MENU_STATE_DISABLED = ODS_DISABLED
assert MENU_STATE_CHECKED = ODS_CHECKED
assert MENU_STATE_DEFAULT = ODS_DEFAULT
assert MENU_STATE_HOT = ODS_HOTLIGHT
assert MENU_STATE_COMBOBOXEDIT = ODS_COMBOBOXEDIT
assert (MENU_STATE_RADIO and MENU_STATE_ODS_MASK) = 0
assert (MENU_STATE_HASSUB and MENU_STATE_ODS_MASK) = 0

