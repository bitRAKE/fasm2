; apx_ndd.ref -- error checks of tests/iset/apx_ndd.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: NDD only: adc, sbb, not, rcl, rcr
use64
use everything
use vexauto, rexauto
adc {nf} rax, rbx		; '{nf} not supported by this instruction'

; FAIL 2
use64
use everything
use vexauto, rexauto
not {nf} rax		; '{nf} not supported by this instruction'

; FAIL 3: options are {nf} and {zu} only
use64
use everything
use vexauto, rexauto
add {nx} rax, rbx		; 'unknown instruction option'

; FAIL 4: the NDD has the operation's size
use64
use everything
use vexauto, rexauto
add r16d, rax, rbx		; 'operand sizes do not match'

; FAIL 5: no ah-bh in EVEX map 4
use64
use everything
use vexauto, rexauto
add ah, bl, cl		; 'disallowed combination of registers'

; FAIL 6: LOCK/REP before EVEX: #UD
use64
use everything
use vexauto, rexauto
lock add {nf} [rax], rbx		; 'prefix not allowed with EVEX'

; FAIL 7
use64
use everything
use vexauto, rexauto
rep add {nf} rax, rbx		; 'prefix not allowed with EVEX'

; FAIL 8
use64
use everything
use vexauto, rexauto
use i386, x64
add rax, rbx, rcx		; 'APX_F or higher required'

; FAIL 9
use64
use everything
use vexauto, rexauto
use32
add eax, ebx, ecx		; 'bits64 or higher required'

; FAIL 10: the NDD is a register
use64
use everything
use vexauto, rexauto
add [rax], rbx, rcx		; 'invalid new data destination'

; FAIL 11: plus the instruction's own feature
use64
use everything
use vexauto, rexauto
use i386, x64, APX_F
popcnt {nf} rax, rbx		; 'POPCNT required'

; FAIL 12: mul has no NDD form
use64
use everything
use vexauto, rexauto
mul rax, rbx		; 'extra characters on line'

; FAIL 13: imul ndd, r, r/m: the first source is a register
use64
use everything
use vexauto, rexauto
imul rax, [rbx], rcx		; 'invalid combination of operands'
