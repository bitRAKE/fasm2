; amd.ref -- error checks of tests/iset/amd.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: each feature gates only its own instructions
use vexauto, rexauto
use i386, CLZERO
monitorx		; 'MONITORX or higher required'

; FAIL 2
use vexauto, rexauto
use i386, MONITORX
clzero		; 'CLZERO or higher required'

; FAIL 3
use vexauto, rexauto
use i386, RDPRU
tlbsync		; 'INVLPGB or higher required'

; FAIL 4
use vexauto, rexauto
use i386, INVLPGB
rdpru		; 'RDPRU or higher required'

; FAIL 5: MONITORX does not provide MCOMMIT
use vexauto, rexauto
use i386, MONITORX
mcommit		; 'MCOMMIT or higher required'

; FAIL 6: the address must be rAX
use vexauto, rexauto
use64
clzero rbx		; 'rAX expected'

; FAIL 7: MONITORX extensions are in ECX
use vexauto, rexauto
use64
monitorx rax, rcx, edx		; 'invalid implicit operand: rcx, expected ecx'

; FAIL 8: INVLPGB: rAX, EDX, ECX in that order
use vexauto, rexauto
use64
invlpgb rax, ecx, edx		; 'invalid implicit operand: ecx, expected edx'

; FAIL 9: a 64-bit address only exists in long mode
use vexauto, rexauto
use32
clzero rax		; 'invalid operand size'
