; xop.ref -- error checks of tests/iset/xop.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: FMA4 does not provide XOP
use64
use vexauto, rexauto
use i386, x64, AVX, FMA4
vpcmov xmm0, xmm1, xmm2, xmm3		; 'XOP or higher required'

; FAIL 2: vpperm is 128-bit only
use64
use vexauto, rexauto
use everything
vpperm ymm0, ymm1, ymm2, ymm3		; 'invalid combination of operands'

; FAIL 3: vpmacs* take the accumulator in a register (is4)
use64
use vexauto, rexauto
use everything
vpmacsdd xmm0, xmm1, xmm2, [rax]		; 'invalid combination of operands'

; FAIL 4: only one memory operand
use64
use vexauto, rexauto
use everything
vpcmov xmm0, xmm1, [rax], [rbx]		; 'invalid combination of operands'

; FAIL 5: no immediate count for vpshl
use64
use vexauto, rexauto
use everything
vpshlb xmm0, xmm1, 3		; 'invalid combination of operands'

; FAIL 6: VEX layout: no xmm16+
use64
use vexauto, rexauto
use everything
vfrczps xmm0, xmm17		; 'invalid operand'

; FAIL 7: XOP vector instructions need AVX
use64
use vexauto, rexauto
use i386, x64, XOP
vpcmov xmm0, xmm1, xmm2, xmm3		; 'AVX or higher required'
