; FAIL 1: ND=0 NF=0 in row 4 is cfcmov's load form
use64
use everything
use vexauto, rexauto
{evex} cmovb rax, rbx		; 'no EVEX form for this instruction'

; FAIL 2: cmov's NF bit means cfcmov
use64
use everything
use vexauto, rexauto
cmovb {nf} rax, rbx		; '{nf} not supported by this instruction'

; FAIL 3: ZU: imul r, r/m, imm only
use64
use everything
use vexauto, rexauto
imul {zu} rax, rbx		; '{zu} not supported by this instruction'

; FAIL 4: this is the NDD form
use64
use everything
use vexauto, rexauto
imul {zu} rax, rbx, rcx		; '{zu} not supported by this instruction'

