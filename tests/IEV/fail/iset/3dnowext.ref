; FAIL 1: 3DNow alone (K6-2) has no pswapd
use32
use vexauto, rexauto
use i386, MMX, 3DNow
pswapd mm1, mm2		; '3DNowExt or higher required'

; FAIL 2: nor pi2fw (behaviour change)
use32
use vexauto, rexauto
use i386, MMX, 3DNow
pi2fw mm1, mm2		; '3DNowExt or higher required'

; FAIL 3: 3DNowExt does not imply 3DNow
use32
use vexauto, rexauto
use i386, MMX, 3DNowExt
pfadd mm1, mm2		; '3DNow or higher required'

; FAIL 4: MMX registers
use32
use vexauto, rexauto
use everything
pswapd xmm1, xmm2		; 'invalid combination of operands'
