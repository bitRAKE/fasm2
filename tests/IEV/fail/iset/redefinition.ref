; redefinition.ref -- error checks of tests/iset/redefinition.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: neither F16C nor AVX-512
use64
use vexauto, rexauto
use i386, x64, AVX
vcvtph2ps ymm1, xmm2		; 'F16C required'

; FAIL 2: F16C alone has no zmm form
use64
use vexauto, rexauto
use i386, x64, AVX, F16C
vcvtph2ps zmm1, ymm2		; 'invalid operand'

; FAIL 3: 256-bit vpmuldq needs AVX2
use64
use vexauto, rexauto
use i386, x64, AVX
vpmuldq ymm1, ymm2, ymm3		; 'AVX2 or higher required'

; FAIL 4: vpmullq is AVX512DQ, not AVX512F
use64
use vexauto, rexauto
use i386, x64, AVX512F
vpmullq zmm1, zmm2, zmm3		; 'AVX512DQ or higher required'
