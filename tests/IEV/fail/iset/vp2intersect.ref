; vp2intersect.ref -- error checks of tests/iset/vp2intersect.asm in IEV form
; generated by tests/IEV/_iset2ref.py; edit the iset test, not this file

; FAIL 1: AVX512F alone is not enough
use64
use vexauto, rexauto
use i386, x64, AVX512F
vp2intersectd k2, zmm2, zmm3		; 'AVX512_VP2INTERSECT or higher required'

; FAIL 2: k3 is the odd half of a pair
use64
use vexauto, rexauto
use everything
vp2intersectd k3, zmm2, zmm3		; 'even mask register expected'

; FAIL 3: 256-bit form needs AVX512VL
use64
use vexauto, rexauto
use i386, x64, AVX512F, AVX512_VP2INTERSECT
vp2intersectd k2, ymm2, ymm3		; 'AVX512VL or higher required'

; FAIL 4: destination is a mask register
use64
use vexauto, rexauto
use everything
vp2intersectd zmm1, zmm2, zmm3		; 'invalid combination of operands'

; FAIL 5: sources the same width
use64
use vexauto, rexauto
use everything
vp2intersectq k2, zmm2, ymm3		; 'operand sizes do not match'
